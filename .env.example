# Copy this file to .env and adjust values as needed for your environment.

# Port the HTTP server listens on
PORT=3000

# Number of decimal places to round split order quantities to
QUANTITY_DECIMAL_PLACES=5

# Fallback stock price used when none is supplied
DEFAULT_STOCK_PRICE=100

# Market session window (UTC, 24h "HH:MM")
MARKET_OPEN_UTC=13:30
MARKET_CLOSE_UTC=20:00
